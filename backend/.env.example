# Gmail credentials for the KTrade confirmation importer.
# Obtain with: node scripts/gmail_auth.cjs <CLIENT_ID> <CLIENT_SECRET>
# Never commit the real values - together they grant read access to the mailbox.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

# Who KTrade confirmations arrive from.
KTRADE_SENDER=settlement@kasb.com
