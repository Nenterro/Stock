# Copy to mcp/.env (gitignored) and fill in. Restart the MCP server after edits
# (in Claude Code: /mcp, then reconnect stock-tracker).

# Your Stock Tracker login (the PocketBase account the app signs in with).
PB_EMAIL=
PB_PASSWORD=

# Your 4-digit encryption PIN. Required if the app has E2EE on: without it the
# server can neither read your data nor write records the app can open.
E2EE_PIN=

# Bearer token for the stock-api write routes (fund/fundamentals overrides,
# screener rebuild). Must match STOCK_API_WRITE_TOKEN in ~/Docker/stock-api/.env
# on the home server.
STOCK_API_WRITE_TOKEN=

# Let Claude record transactions (always previewed, then confirmed). Off by default.
ALLOW_TRANSACTION_WRITES=false

# Optional overrides; comma-separated lists are tried in order (add the home
# server's LAN address as a fallback here, not in committed files).
# STOCK_API_URL=https://huz-stock.duckdns.org:8888
# PB_URL=https://huz-budget.duckdns.org:8888
